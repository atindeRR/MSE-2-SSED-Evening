POSTGRES_DB=taskflow
POSTGRES_USER=taskflow_user
# Use a URL-safe value (letters and numbers) because it is part of DATABASE_URL.
POSTGRES_PASSWORD=replace_with_a_unique_url_safe_password
# Generate locally with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret
# Set your Docker Hub account before using docker-compose.deploy.yml.
DOCKERHUB_USERNAME=your_dockerhub_username
