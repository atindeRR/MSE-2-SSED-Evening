# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholder values with your configuration.
# Never commit actual passwords or credentials to version control.
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow_user
POSTGRES_PASSWORD=change_this_secure_password

# Database Connection URL (Backend uses hostname 'postgres' on Docker network)
DATABASE_URL=postgresql://taskflow_user:change_this_secure_password@postgres:5432/taskflow

# Redis Cache Configuration (Backend uses hostname 'redis' on Docker network)
REDIS_URL=redis://redis:6379

# Application Secrets & Networking
JWT_SECRET=replace_with_a_long_random_secret_for_jwt_signing
PORT=3000

# Docker Hub Configuration (Used for Image-based Deployment and CI/CD)
DOCKERHUB_USERNAME=your_dockerhub_username
