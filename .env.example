# Copy this file to .env and replace every value marked CHANGE_ME.
# Use URL-safe characters in POSTGRES_PASSWORD because Compose creates DATABASE_URL from it.
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow_user
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_URL_SAFE_PASSWORD
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_JWT_SECRET

# Docker Hub image repositories (without a tag). These are required by docker-compose.deploy.yml.
DOCKERHUB_USERNAME=CHANGE_ME_DOCKERHUB_USERNAME
FRONTEND_IMAGE=${DOCKERHUB_USERNAME}/frontend
BACKEND_IMAGE=${DOCKERHUB_USERNAME}/backend
IMAGE_TAG=latest
